{
  "manifest_version": 3,
  "name": "Stay Halong OnePay Invoice Auto Fill",
  "version": "1.0.0",
  "description": "Stay Halong 매니저의 고객명과 결제금액을 OnePay Invoice 작성 화면에 자동 입력합니다.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://onepay.vn/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onepay.vn/auth-invoice/*",
        "https://onepay.vn/invoice/*",
        "https://onepay.vn/invoice20/*"
      ],
      "js": ["onepay-autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://manager.stayhalong.com/*",
      "https://manag.stayhalong.com/*",
      "http://localhost:3001/*",
      "http://localhost:3005/*"
    ]
  }
}
