{
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" \"${VERCEL_GIT_COMMIT_SHA:-HEAD}\" -- ./ ../../packages ../../pnpm-lock.yaml",
  "buildCommand": "cd ../.. && pnpm --filter @sht/manager build",
  "outputDirectory": ".next",
  "framework": "nextjs"
}
